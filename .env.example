# SERVER CONFIGURATION
PORT=4000
NODE_ENV=development
API_HOST=0.0.0.0

# DATABASE CONFIGURATION (MySQL 8 Community Edition)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/wholesale_erp"

# SECURITY & AUTHENTICATION
JWT_SECRET="replace-with-a-very-long-random-secret-key-32-chars-min"
JWT_EXPIRES_IN="24h"
MASTER_PIN="1234"

# BUSINESS DEFAULTS
DEFAULT_BASE_UNIT="KG"
DEFAULT_MANN_KG=40.000000
DEFAULT_COMMISSION_PCT=2.000000

# CLOUD SYNCHRONIZATION (Optional in standalone offline mode)
CLOUD_SYNC_ENABLED=false
CLOUD_API_URL="https://api.yourcloudwholesaleerp.com"
CLOUD_API_KEY=""
DEVICE_ID=""
