{
  "name": "wholesale-ghalla-mandi-erp",
  "version": "1.0.0",
  "description": "Professional Wholesale / Ghalla Mandi Inventory, Commission & Accounting Desktop ERP",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "vercel-build": "prisma generate --schema=./prisma/schema.prisma && node scripts/build-server.mjs",
    "postinstall": "prisma generate --schema=./prisma/schema.prisma",
    "test": "npm run test --workspaces",
    "server": "npm run dev --workspace=@erp/server",
    "desktop": "npm run dev --workspace=@erp/desktop",
    "dev": "concurrently -k \"npm run dev --workspace=@erp/server\" \"npm run dev --workspace=@erp/desktop\"",
    "prisma:generate": "prisma generate --schema=./prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "prisma:seed": "tsx ./prisma/seed.ts"
  },
  "dependencies": {
    "esbuild": "^0.21.5",
    "prisma": "^5.15.0",
    "typescript": "^5.4.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "tsx": "^4.15.4"
  }
}
