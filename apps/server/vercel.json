{
  "version": 2,
  "builds": [
    {
      "src": "src/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "../../prisma/schema.prisma",
          "../../packages/shared-types/src/**",
          "../../packages/business-rules/src/**",
          "../../packages/validation/src/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "src/index.ts"
    }
  ]
}
