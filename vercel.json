{
  "version": 2,
  "buildCommand": "prisma generate --schema=./prisma/schema.prisma && node scripts/build-server.mjs",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/_bundle.js", "node_modules/.prisma/**", "node_modules/@prisma/**"]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
