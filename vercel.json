{
  "version": 2,
  "buildCommand": "prisma generate --schema=./prisma/schema.prisma && cd apps/desktop && npx vite build --outDir ../../public --emptyOutDir",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["api/_bundle.js", "node_modules/.prisma/**", "node_modules/@prisma/**"]
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/health", "dest": "/api/index.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/(.*)", "dest": "/public/index.html" }
  ]
}
