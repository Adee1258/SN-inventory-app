{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/desktop/dist",
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api/index.js" },
    { "source": "/health",        "destination": "/api/index.js" },
    { "source": "/((?!assets/).*)", "destination": "/index.html" }
  ]
}
