{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/desktop/dist",
  "rewrites": [
    {
      "source": "/api/v1/:match*",
      "destination": "/api"
    },
    {
      "source": "/health",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|assets/|favicon.ico).*)",
      "destination": "/index.html"
    }
  ]
}
