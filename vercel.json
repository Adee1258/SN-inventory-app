{
  "version": 2,
  "buildCommand": "prisma generate --schema=./prisma/schema.prisma && node scripts/build-server.mjs",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
