{
  "version": 2,
  "buildCommand": "npm run vercel-build",
  "outputDirectory": "apps/desktop/dist",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs20.x",
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/v1/:match*", "destination": "/api/index.js" },
    { "source": "/health",         "destination": "/api/index.js" },
    { "source": "/((?!assets/|favicon.ico|api/).*)", "destination": "/index.html" }
  ]
}
